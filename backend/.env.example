DATABASE_URL=                        # Neon/Postgres, use ?sslmode=verify-full
REFRESH_SECRET=                      # any long random string, cron sends it as x-refresh-secret
VOTE_SALT=                           # salts the hashed voter id, falls back to REFRESH_SECRET
FRONTEND_URL=http://localhost:5188  # must match the vite port pinned in vite.config.ts
PORT=3001

# POST /api/refresh/tick scrapes when the current IST time is at, or up to
# REFRESH_GRACE_MIN past, one of these, never before. One cron hits it every
# five minutes. Restrict weekdays in the cron schedule.
REFRESH_TARGETS=07:00,08:00,09:45,11:30,12:15,13:15,15:00   # IST, 24h, comma separated
REFRESH_GRACE_MIN=5                  # minutes after a target a tick still counts; keep >= cron interval
